# --- Continuum engine (REST) -------------------------------------------------
FELDERA_URL=http://localhost:8081
# Engine address as seen from inside the docker network (snapshot connector of derived streams)
FELDERA_INTERNAL_URL=http://feldera:8080
BASE_PIPELINE=arrival-capacity
COMPILE_TIMEOUT_SECS=600
POLL_INTERVAL_SECS=5
DEFAULT_WORKERS=2

# --- Broker management (SEMP v2) --------------------------------------------
SEMP_URL=http://localhost:8089
SEMP_USER=admin
SEMP_PASS=admin
SEMP_VPN=default
QUEUE_MAX_TTL_SECS=300
QUEUE_MAX_SPOOL_MB=500

# --- Broker coordinates as the engine container sees them --------------------
FL_SOLACE_HOSTNAME=solace
FL_SOLACE_PORT=55555
FL_SOLACE_VPN=default
FL_SOLACE_USER=default
FL_SOLACE_PASSWORD=default

# --- Event Portal (registration is skipped when the token is unset) ----------
EP_BASE_URL=https://api.solace.cloud/api/v2/architecture
SOLACE_API_TOKEN=
CONTINUUM_EP_DOMAIN=FAA Arrival Capacity

# --- MCP server --------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8091
# Bearer token clients must present. Leave empty to disable auth (logs a warning).
CONTINUUM_MCP_TOKEN=
CATALOG_DIR=./catalog
# Wire envelope of the engine's JSON sink (confirmed on the live stack): insert | bare
TRIGGER_ENVELOPE=insert
# Optional Host allow-list (comma-separated); unset = accept any Host header
MCP_ALLOWED_HOSTS=
