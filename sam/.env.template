# fast-triage-deep-analysis / sam — environment template
#
# Copy to sam/.env and fill in. NEVER commit .env. Every ${VAR} used by the
# YAML under sam/ is listed here. Values shown are placeholders or the local
# docker-compose defaults, not real credentials.

# ── LLM (OpenAI-compatible endpoint: LiteLLM proxy or direct) ──────────────
# Used by models/general.yaml (fast path) and models/investigation.yaml (System 2).
LLM_SERVICE_ENDPOINT=https://your-litellm-or-openai-endpoint/v1
LLM_SERVICE_API_KEY=replace-me
LLM_SERVICE_GENERAL_MODEL_NAME=gpt-4o
# Optional Sonnet-class slot for the System-2 Lead Investigator synthesis.
# Leave unset to fall back to LLM_SERVICE_PLANNING_MODEL_NAME then GENERAL.
#LLM_SERVICE_INVESTIGATION_MODEL_NAME=gpt-4o
#LLM_SERVICE_PLANNING_MODEL_NAME=gpt-4o

# ── SAM platform (sam config plan/apply/pull against localhost:8800) ────────
# The embedded platform started by scripts/run-embedded.sh is unauthenticated
# by default — leave empty unless you enabled OIDC/RBAC.
SAM_PLATFORM_TOKEN=

# ── Continuum MCP (streaming-data layer; connectors/continuum-mcp.yaml) ─────
# Tools: list_source_streams, list_data_products, get_data_product,
# search_catalog, preview_query, create_data_product, create_trigger,
# delete_trigger, delete_data_product, get_status, sync_event_portal.
CONTINUUM_MCP_URL=http://localhost:8091/mcp
# Bearer token; the connector schema requires 10–8192 characters.
CONTINUUM_MCP_TOKEN=replace-me-min-10-chars

# ── Event Portal MCP (connectors/event-portal-mcp.yaml) ────────────────────
EP_MCP_URL=http://localhost:8092/mcp
# Bearer token presented to the Event Portal MCP server (10–8192 characters).
EP_MCP_TOKEN=replace-me-min-10-chars
# Solace Cloud API token the Event Portal MCP server itself uses to reach
# Event Portal (consumed by that server's process, not by SAM).
SOLACE_API_TOKEN=replace-me

# ── Event Mesh broker for the solution's event_mesh gateway (SMF) ───────────
# Referenced by the arrival-capacity entrypoint and the event-mesh-publish
# connector. Local docker-compose defaults shown; the password is never
# inherited from the platform broker.
EVENT_MESH_SOLACE_BROKER_URL=tcp://localhost:55555
EVENT_MESH_SOLACE_BROKER_VPN=default
EVENT_MESH_SOLACE_BROKER_USERNAME=default
EVENT_MESH_SOLACE_BROKER_PASSWORD=default

# ── Optional: scripts/run-embedded.sh listen addresses ─────────────────────
#SAM_LISTEN=:8800
#SAM_HEALTH_ADDR=:8810
