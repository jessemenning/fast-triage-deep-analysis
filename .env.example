# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Values here are read by `docker compose` (variable substitution) and by the
# host `sam` CLI at `sam config apply` time. URLs are as seen from INSIDE the
# compose network (SAM and the MCP servers run as containers).

# ── LLM (required) ────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint (e.g. a LiteLLM proxy). The key is a secret.
LLM_SERVICE_ENDPOINT=https://your-litellm-or-openai-endpoint/v1
LLM_SERVICE_API_KEY=replace-me
# SAM exposes model slots. GENERAL powers the fast path — the triage decider
# plus the System-2 specialist agents — use a LIGHT model. INVESTIGATION (below)
# powers the System-2 Lead Briefer synthesis — use a STRONGER (Sonnet-class) model.
# Point the slots at DIFFERENT models / backend pools so a slow investigation and the
# fast path don't share one rate-limit bucket — a shared bucket surfaces as HTTP 429
# "rate limit exceeded" and the workflow returns a null decision.
#
# Recommended on the Solace LiteLLM proxy (separate Vertex vs Bedrock pools):
LLM_SERVICE_GENERAL_MODEL_NAME=claude-haiku-4-5-20251001-vertex
LLM_SERVICE_PLANNING_MODEL_NAME=bedrock-claude-4-5-sonnet-tools
# Generic OpenAI-compatible endpoint instead? e.g. gpt-4o-mini (general) / gpt-4o (stronger).
# PLANNING is kept only as the fallback the INVESTIGATION slot defaults to (below).
#
# INVESTIGATION powers the fast/slow System-2 investigation (the Lead Briefer
# synthesis, ESCALATEd breaches only). The slow path runs rarely, so use a STRONGER
# (Sonnet-class) model — synthesis + tool/JSON reliability matter more than latency.
# Point it at a DIFFERENT pool than the fast `general` path so an investigation can't
# starve or be starved. Unset -> falls back to the planning model name above (also Sonnet).
LLM_SERVICE_INVESTIGATION_MODEL_NAME=bedrock-claude-4-5-sonnet-tools

# ── SAM platform ──────────────────────────────────────────────────────────────
SAM_PLATFORM_TOKEN=sam-internal-dev-token-rtai   # any non-empty string locally
# SAM runtime image. This repo targets 2.409.2 — the official release with the
# native OpenAI Decisions decision provider (DATAGO-154778, PRs #4484+#4485). Official
# prebuilt release image via `gh release download` + `docker load`; see CLAUDE.md.
# The host CLI must match: use the `sam-2.409.2` binary (Makefile `SAM` var).
SAM_IMAGE=solace-agent-mesh:2.409.2
# Rollback to 2.380.0: set SAM_IMAGE=solace-agent-mesh:2.380.0 above and run make with
# SAM=sam-2.380.0 (reverts to the TypeSafe Jev decision model in git history).
#SAM_IMAGE=solace-agent-mesh:2.380.0

# ── Data-plane broker (as SAM/Continuum see it inside the compose network) ────
EVENT_MESH_SOLACE_BROKER_URL=tcp://solace:55555
EVENT_MESH_SOLACE_BROKER_VPN=default
EVENT_MESH_SOLACE_BROKER_USERNAME=default
EVENT_MESH_SOLACE_BROKER_PASSWORD=default

# ── MCP servers (in-network URLs; tokens are the client<->server bearer) ──────
CONTINUUM_MCP_URL=http://continuum-mcp:8091/mcp
CONTINUUM_MCP_TOKEN=continuum-dev-token-local
EP_MCP_URL=http://ep-mcp:8092/mcp
EP_MCP_TOKEN=ep-dev-token-local-0001

# ── Event Portal (optional) ───────────────────────────────────────────────────
# Leave empty to run without Event Portal. Set a Solace Cloud API token to enable
# Continuum's producer-side registration and the agent's EP discovery.
SOLACE_API_TOKEN=

# ── Engine image override (optional) ──────────────────────────────────────────
# Stock upstream Feldera — Solace I/O is handled by the sidecar, not the engine.
#FELDERA_IMAGE=ghcr.io/feldera/pipeline-manager:latest

# ── feldera-solace sidecar (optional overrides) ───────────────────────────────
# The sidecar bridges Solace⇄Feldera (replaces the old in-engine connector). By
# default it is BUILT from the sibling repo ../continuum-solace-connector (OSS, non-FIPS).
# Point SIDECAR_CONTEXT elsewhere if the repo lives at another path, or set
# SIDECAR_IMAGE to a prebuilt tag to skip the build.
#SIDECAR_CONTEXT=../continuum-solace-connector
#SIDECAR_IMAGE=continuum-solace-connector:dev
#SIDECAR_LOG=info

# ── Decision node (native OpenAI-Decisions via LiteLLM) ───────────────────────
# The `arrival_decider` decision model (sam/solutions/arrival-capacity/models/
# arrival_decider.yaml) POSTs native OpenAI-Decisions calls to the MaaS LiteLLM proxy
# at <LLM_SERVICE_ENDPOINT>/v1/decisions — it REUSES LLM_SERVICE_ENDPOINT +
# LLM_SERVICE_API_KEY above (apiBase "${LLM_SERVICE_ENDPOINT}/v1", api_key
# "${LLM_SERVICE_API_KEY}"), substituted into the model resource at `sam config apply`.
# modelName is `microsoft-decision-1` — the only model wired to /v1/decisions on this
# proxy. No separate decision key or in-stack proxy: the old OpenRouter/decision-proxy
# route is retired.

# ── Demo scenario ─────────────────────────────────────────────────────────────
# Hero airport the wind-shift scenario degrades (ICAO). Default Newark.
HERO_AIRPORT=KEWR
# Replay feed pacing: 1.0 = real-time, 2.0 = 2x faster. Loop the corpus when it ends.
REPLAY_SPEED=1.0
REPLAY_LOOP=true
# Native workflow decision node (#4241) is behind this feature flag (off by default
# in SAM). Required on BOTH the host CLI (to parse/apply `type: decision`) and the
# runtime (docker-compose passes it through). Leave true to use the decision node.
SAM_FEATURE_WORKFLOW_DECISION_NODE=true
